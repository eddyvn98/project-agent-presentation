# NON-SECRET EXAMPLE FOR ISOLATED QA ONLY. Never commit local env files.
PROJECT_AGENT_RUNTIME=sandbox
PROJECT_AGENT_BROWSER_AGENT=1
PROJECT_AGENT_P7_QA_FIXTURE=1
PROJECT_AGENT_P7_QA_CRASH=0
# PROJECT_AGENT_CHROMIUM_EXECUTABLE=/absolute/path/to/chrome
NEXTAUTH_URL=http://127.0.0.1:3004
# Set NEXTAUTH_SECRET and Entra credentials privately on the QA host.
# The callback for provider azure-ad must be registered in Entra:
# http://127.0.0.1:3004/api/auth/callback/azure-ad
