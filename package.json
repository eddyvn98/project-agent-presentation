{
  "name": "project-agent-presentation-lab",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Portable React presentation components for agent chat responses",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.calculator.json",
    "typecheck:calculator": "tsc --project tsconfig.calculator.json",
    "test": "vitest run",
    "demo": "vite --host 127.0.0.1",
    "build:demo": "vite build",
    "test:e2e": "playwright test",
    "test:agent-ui:e2e": "playwright test --config playwright.agent-ui.config.ts",
    "test:agent-ui:cross": "playwright test --config playwright.agent-ui.cross.config.ts",
    "check:lines": "node tests/check-lines.mjs",
    "test:agent": "vitest run --config vitest.agent.config.ts",
    "check:agent-routes": "node scripts/check-agent-routes.mjs",
    "check:host:p7": "node scripts/p7-host-preflight.mjs",
    "test:host:p7": "playwright test --config playwright.host.config.ts",
    "p7:qa:browser": "node scripts/p7-browser-preflight.mjs",
    "p7:qa:readiness": "node scripts/p7-host-readiness.mjs",
    "p7:qa:sso": "node scripts/p7-sso-preflight.mjs",
    "p7:qa:session": "node scripts/p7-session-preflight.mjs",
    "p7:qa:create": "node scripts/p7-qa-bootstrap.mjs create",
    "p7:qa:cleanup": "node scripts/p7-qa-bootstrap.mjs cleanup",
    "p7:qa:auth-tests": "node --test tests/node/p7-*.test.mjs",
    "test:p7:multiworker:unit": "vitest run --config vitest.agent.config.ts tests/agent/p7-multiworker-mongo-lease.test.ts tests/agent/p7-qa-stop-cleanup.test.ts",
    "test:p7:terminal": "vitest run --config vitest.agent.config.ts tests/agent/p7-terminal-write-stop-race.test.ts tests/agent/p7-qa-stop-cleanup.test.ts",
    "test:p7:security": "vitest run --config vitest.agent.config.ts tests/agent/p7-security-review.test.ts tests/agent/p7-qa-safety.test.ts",
    "test:p7:multiworker:db": "node scripts/p7-multiworker-mongo-qa.mjs",
    "test:p8:unit": "vitest run --config vitest.agent.config.ts tests/agent/p8-browser-stall-guard.test.ts tests/agent/p8-browser-loop-state.test.ts tests/agent/p8-browser-loop-step.test.ts tests/agent/p8-browser-loop-route.test.ts tests/agent/p8-browser-scorecard.test.ts tests/agent/p8-loop-metrics.test.ts",
    "test:p8:qa:unit": "vitest run --config vitest.agent.config.ts tests/agent/p8-qa-session-guard.test.ts tests/agent/p8-qa-session-bridge.test.ts",
    "test:host:p8:closeout": "node scripts/p8-session-preflight.mjs && playwright test --config playwright.host.config.ts tests/host-browser/p8-loop-closeout.api.spec.ts --project=host-api",
    "test:p8:browser": "vitest run --config vitest.agent.config.ts tests/agent/p8-browser-real.test.ts",
    "test:p7:closeout": "vitest run --config vitest.agent.config.ts tests/agent/p7-qa-recovery-race.test.ts tests/agent/p7-qa-conditional-update.test.ts tests/agent/p7-qa-browser-cleanup.test.ts tests/agent/p7-qa-stop-cleanup.test.ts",
    "test:p7:host-schema": "node --test tests/host-schema/p7-task-collection.contract.mjs",
    "test:host:p7:closeout": "node scripts/p7-session-preflight.mjs --mutation && playwright test --config playwright.host.config.ts tests/host-browser/p7-cas-stop.api.spec.ts --project=host-api",
    "test:g1:unit": "vitest run --config vitest.agent.config.ts tests/agent/g1-goal-check.test.ts",
    "test:host:g1": "node scripts/g1-host-preflight.mjs && playwright test --config playwright.host.config.ts tests/host-browser/g1-goal-runtime.api.spec.ts --project=host-api",
    "test:g2:unit": "node --test tests/node/g2-browser-lease.test.mjs",
    "test:g2:multiworker:db": "node scripts/g2-multiworker-browser-qa.mjs",
    "test:p1:stress": "node scripts/p1-stress-mongo-qa.mjs",
    "test:p1:chaos": "node scripts/p1-chaos-mongo-qa.mjs",
    "test:host:g2": "node scripts/g2-host-preflight.mjs && playwright test --config playwright.host.config.ts tests/host-browser/g2-two-next.api.spec.ts --project=host-api",
    "test:g2:origin": "node --test tests/node/g2-host-origins.test.mjs",
    "test:g2:mode:unit": "vitest run --config vitest.agent.config.ts tests/agent/g2-browser-op-mode.test.ts",
    "test:g2:crash:unit": "node --test tests/node/g2-refs.test.mjs tests/node/g2-crash-hosts.test.mjs",
    "test:host:g2:crash": "node scripts/g2-crash-e2e.mjs",
    "test:inspiration:agent": "vitest run --config vitest.agent.config.ts tests/agent/browser-visual-viewport.test.ts tests/agent/browser-webmcp-readonly.test.ts",
    "test:inspiration:presentation": "vitest run tests/presentation-scene3d.test.tsx",
    "test:browser:binary-integrity": "vitest run --config vitest.agent.config.ts tests/agent/browser-binary-integrity.test.ts"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-popover": "^1.3.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.0.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^15.6.0",
    "recharts": "^2.15.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
