{
  "name": "project-agent-presentation-lab",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Portable React presentation components for agent chat responses",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.calculator.json",
    "typecheck:calculator": "tsc --project tsconfig.calculator.json",
    "test": "vitest run",
    "demo": "vite --host 127.0.0.1",
    "build:demo": "vite build",
    "test:e2e": "playwright test",
    "check:lines": "node tests/check-lines.mjs",
    "test:agent": "vitest run --config vitest.agent.config.ts",
    "check:agent-routes": "node scripts/check-agent-routes.mjs",
    "check:host:p7": "node scripts/p7-host-preflight.mjs",
    "test:host:p7": "playwright test --config playwright.host.config.ts",
    "p7:qa:browser": "node scripts/p7-browser-preflight.mjs",
    "p7:qa:readiness": "node scripts/p7-host-readiness.mjs",
    "p7:qa:sso": "node scripts/p7-sso-preflight.mjs",
    "p7:qa:session": "node scripts/p7-session-preflight.mjs",
    "p7:qa:create": "node scripts/p7-qa-bootstrap.mjs create",
    "p7:qa:cleanup": "node scripts/p7-qa-bootstrap.mjs cleanup",
    "p7:qa:auth-tests": "node --test tests/node/p7-*.test.mjs",
    "test:p7:multiworker:unit": "vitest run --config vitest.agent.config.ts tests/agent/p7-multiworker-mongo-lease.test.ts tests/agent/p7-qa-stop-cleanup.test.ts",
    "test:p7:multiworker:db": "node scripts/p7-multiworker-mongo-qa.mjs",
    "test:p7:closeout": "vitest run --config vitest.agent.config.ts tests/agent/p7-qa-recovery-race.test.ts tests/agent/p7-qa-conditional-update.test.ts tests/agent/p7-qa-browser-cleanup.test.ts tests/agent/p7-qa-stop-cleanup.test.ts",
    "test:p7:host-schema": "node --test tests/host-schema/p7-task-collection.contract.mjs",
    "test:host:p7:closeout": "node scripts/p7-session-preflight.mjs --mutation && playwright test --config playwright.host.config.ts tests/host-browser/p7-cas-stop.api.spec.ts --project=host-api"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-popover": "^1.3.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.0.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^15.6.0",
    "recharts": "^2.15.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
